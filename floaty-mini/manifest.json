{
  "manifest_version": 3,
  "name": "Floaty Mini Player",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "Lightweight mini player for any page (crop any region), video-only YouTube, a music disc + music bar for Spotify / YouTube Music, and auto ad-skip.",
  "permissions": ["storage", "scripting", "declarativeNetRequestWithHostAccess", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_title": "Show Floaty controls" }
}
